{
  "name": "aitiarch-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local web notebook UI for Aitiarch (Phase 1: shell and editor)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/main.ts",
    "test": "vitest run",
    "test:native": "node test/native-load.mjs",
    "test:holdout": "node scripts/anchoring-holdout.mjs mapping",
    "test:holdout:search": "node scripts/anchoring-holdout.mjs search",
    "test:anchors:sweep": "node scripts/anchoring-sweep.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json",
    "check:phase1": "vite build && node check/phase1.mjs",
    "check:projects-home": "vite build && node check/projects-home.mjs",
    "check:invoked": "vite build && node check/invoked.mjs",
    "check:threads": "vite build && node check/threads.mjs",
    "check:skills": "vite build && node check/skills.mjs",
    "check:blobs": "vite build && node check/blobs.mjs",
    "check:chat-send": "vite build && node check/chat-send.mjs",
    "check:persona": "vite build && node check/persona.mjs",
    "check:claim-chips": "vite build && node check/claim-chips.mjs",
    "check:investigate-ui": "vite build && node check/investigate-ui.mjs",
    "check:skill-diagram-layout": "vite build && node check/skill-diagram-layout.mjs",
    "check:focus-frame": "vite build && node check/focus-frame.mjs",
    "fixture": "node check/manual-fixture.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "codemirror": "6.0.2",
    "d3-force": "3.0.1",
    "dictionary-en": "4.0.0",
    "dompurify": "3.4.17",
    "mermaid": "12.3.0",
    "nspell": "2.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
