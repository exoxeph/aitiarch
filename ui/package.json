{
  "name": "aitiarch-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local web notebook UI for Aitiarch (Phase 1: shell and editor)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/main.ts",
    "test": "vitest run",
    "test:holdout": "node scripts/anchoring-holdout.mjs mapping",
    "test:holdout:search": "node scripts/anchoring-holdout.mjs search",
    "test:anchors:sweep": "node scripts/anchoring-sweep.mjs",
    "typecheck": "tsc --noEmit",
    "check:phase1": "vite build && node check/phase1.mjs",
    "fixture": "node check/manual-fixture.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/markdown": "1.8.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
