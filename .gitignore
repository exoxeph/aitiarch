spike/results/
spike/scratch/
__pycache__/

# Local probe contains fragments of real session messages; never publish.
/spike/reliability_probe.py

# Byte-exact original notes retained locally before publication redaction.
/NOTES.private.md

# Git Bash crash dumps (a shell artifact, not project output).
*.stackdump

# Opt-in local capture of rejected diagram specs (AITIARCH_DEBUG_DIAGRAMS=1); may contain note text.
/ui/.debug-diagrams/

# Dependencies and build output at any level (ui/.gitignore repeats these for work done inside ui/).
node_modules/
dist/
*.log

# Secrets and local environment files.
.env
.env.*

# A notebook folder or the trial notebook must never be committed into the repo.
.aitiarch/
aitiarch-trial/

# OS junk.
.DS_Store
Thumbs.db
desktop.ini
